# Copy this file to .env before running the app

# Port the server listens on
PORT=5000

# Secret used to sign JWT auth tokens — change this to a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Set to "production" when deploying
NODE_ENV=development

# ---- Amazon RDS (MySQL) connection settings ----
# Found on your RDS instance's "Connectivity & security" tab in the AWS console.
DB_HOST=your-db-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_db_password
DB_NAME=pulse_chat

# Set to "true" to connect over SSL (recommended; required by some RDS configurations)
DB_SSL=true
